+        pocket_mask = min_dist < POCKET_CUTOFF
+        # Also exclude non-standard residues (aa > 19)
+        standard_mask = rec['aa'] <= 19
+        pocket_mask = pocket_mask & standard_mask
+        if pocket_mask.sum() < 1:
+            raise ValueError('no receptor residues within pocket cutoff')
+        # Filter receptor to pocket residues
