+"""De novo capable AnchorBasedSampler.
+
+Original ``sample()`` requires GT peptide coordinates for anchor initialization.
+This revised version adds ``sample_denovo()`` which initializes anchors from
+the receptor surface, enabling true de novo peptide generation.
+"""
+
+from evaluate.tools import data_to_batch, generate_next_coord, generate_prev_coord, coord_from
+from utils.misc import load_config
+import torch
+from models import get_model
+from Bio.SVDSuperimposer import SVDSuperimposer
+import torch.nn.functional as F
+from utils.train import recursive_to
+from modules.common.geometry import dihedral_from_four_points
+from torch.optim import Adam
+from evaluate.geometry import rotation_matrix_to_quaternion, construct_3d_basis
+from torch.distributions.von_mises import VonMises
+
+
+class AnchorBasedSamplerDenovo:
+    """Extended sampler supporting both GT-seeded and de novo anchor initialization."""
+
+    def __init__(self, args):
+        self._init_models(
+            density_config_path=args.density_config_path,
+            density_param_path=args.density_param_path,
+            prediction_config_path=args.prediction_config_path,
+            prediction_param_path=args.prediction_param_path,
+            device=args.device,
+        )
+
+    def _init_models(self, density_config_path, density_param_path,
+                     prediction_config_path, prediction_param_path, device):
+        self.device = device
+
+        density_config, _ = load_config(density_config_path)
+        density_model = get_model(density_config.model).to(device)
+        density_model.load_state_dict(
+            torch.load(density_param_path, map_location=device,
+                       weights_only=False)['model'])
+        density_model.eval()
+        self.density_model = density_model
+
+        prediction_config, _ = load_config(prediction_config_path)
+        prediction_model = get_model(prediction_config.model).to(device)
+        prediction_model.load_state_dict(
+            torch.load(prediction_param_path, map_location=device,
+                       weights_only=False)['model'])
+        prediction_model.eval()
+        self.prediction_model = prediction_model
+
+    # ------------------------------------------------------------------
+    # Surface sampling utilities
+    # ------------------------------------------------------------------
+
+    def _sample_surface_points(self, rec_coord, n_points=1, cutoff_rank=30):
+        """Sample initial anchor positions from the receptor surface.
+
+        Strategy: pick receptor CA atoms that are most exposed (high solvent
+        accessibility proxy = fewer neighbours within 10 Å).  Among the top
+        candidates, randomly select ``n_points`` and add small noise so that
+        the EBM can optimise freely.
+
+        Args:
+            rec_coord: (R, 3, 3) receptor backbone coords (CA, C, N order).
+            n_points: number of surface points to return.
+            cutoff_rank: consider top-k most exposed residues.
+
+        Returns:
+            List of (coord (3,3), aa_placeholder) tuples.
+        """
+        ca_coords = rec_coord[:, 0, :]  # (R, 3)
+        R = ca_coords.shape[0]
+
+        # Exposure heuristic: count neighbours within 10 Å; fewer = more exposed
+        dist_mat = torch.cdist(ca_coords.unsqueeze(0), ca_coords.unsqueeze(0)).squeeze(0)
+        neighbour_count = (dist_mat < 10.0).sum(dim=-1).float()  # (R,)
+
+        # Select from the most exposed residues
+        k = min(cutoff_rank, R)
+        _, exposed_indices = torch.topk(neighbour_count, k, largest=False)
+
+        # Randomly pick n_points among them
+        perm = torch.randperm(k, device=rec_coord.device)[:n_points]
+        selected_indices = exposed_indices[perm]
+
+        results = []
+        for idx in selected_indices:
+            coord = rec_coord[idx].clone()  # (3, 3)
+            # Add noise to move away from the receptor surface
+            x = coord[0] + 3.0 * torch.randn(3, device=coord.device)
+            o = rotation_matrix_to_quaternion(
+                construct_3d_basis(coord[0], coord[1], coord[2]))
+            o = F.normalize(o + 0.5 * torch.randn_like(o), p=2, dim=-1)
+            coord_noisy = coord_from(x, o)
+            aa_placeholder = torch.randint(0, 20, (1,),
+                                           device=coord.device).long()[0]
+            results.append((coord_noisy, aa_placeholder))
+        return results
+
+    # ------------------------------------------------------------------
+    # Core methods (unchanged from original)
+    # ------------------------------------------------------------------
+
+    def _sample_anchor(self, data, coord_init, aa_init, n_steps=100,
+                       lr=3e-2, noise_eps=1e-2, verbose=False):
+        assert coord_init.shape == (3, 3)
+        x_init = coord_init[0]
+        o_init = rotation_matrix_to_quaternion(
+            construct_3d_basis(coord_init[0], coord_init[1], coord_init[2]))
+        par_x = torch.tensor(x_init, requires_grad=True).to(self.device)
+        par_o = torch.tensor(o_init, requires_grad=True).to(self.device)
+        par_cls = torch.tensor(
+            torch.zeros(20).float().to(self.device), requires_grad=True)
+        par_T = torch.tensor(
+            torch.zeros(1).to(self.device), requires_grad=True)
+        optimizer = Adam([par_x, par_o, par_cls, par_T], lr=lr)
+
+        for t in range(n_steps):
+            new_coord = coord_from(par_x, par_o)
+            data_query = {
+                'rec_coord': data['rec_coord'],
+                'rec_aa': data['rec_aa'],
+                'pep_coord': data['pep_coord'][:0],
+                'pep_aa': data['pep_aa'][:0],
+                'qry_coord': torch.cat([new_coord.unsqueeze(0)]),
+                'qry_aa': torch.tensor([0]),
+            }
+            logits = self.density_model(
+                recursive_to(data_to_batch(data_query, collate_type='default'),
+                             self.device))
+            logits = logits[0, 0]
+            prob = F.softmax(logits, -1)
+            assert prob.shape == (21,)
+
+            obj_cls = -torch.log(
+                (prob[:20] * F.softmax(par_cls / par_T.exp())).sum(-1))
+            obj = obj_cls
+            if t % (n_steps // 5) == 0 and verbose:
+                print(f'{t}/{n_steps}, obj: {obj.item():.3f}, '
+                      f'x: {par_x.detach().cpu().numpy()}, '
+                      f'cls:{par_cls.argmax(-1).item()}')
+
+            optimizer.zero_grad()
+            obj.backward()
+            optimizer.step()
+
+            par_x.data.add_(noise_eps * torch.randn_like(par_x))
+            par_o.data.add_(noise_eps * torch.randn_like(par_o))
+            par_o.data.div_(
+                torch.sqrt((par_o ** 2).sum(dim=-1).unsqueeze(-1)))
+
+        coord = coord_from(par_x, par_o).detach()
+        aa = par_cls.argmax(-1).detach()
+        return coord, aa
+
+    def _sample_anchor_denovo(self, rec_data, coord_init, aa_init,
+                              n_steps=100, lr=3e-2, noise_eps=1e-2,
+                              verbose=False):
+        """EBM anchor sampling using receptor-only data (no GT peptide)."""
+        assert coord_init.shape == (3, 3)
+        x_init = coord_init[0]
+        o_init = rotation_matrix_to_quaternion(
+            construct_3d_basis(coord_init[0], coord_init[1], coord_init[2]))
+        par_x = torch.tensor(x_init, requires_grad=True).to(self.device)
+        par_o = torch.tensor(o_init, requires_grad=True).to(self.device)
+        par_cls = torch.tensor(
+            torch.zeros(20).float().to(self.device), requires_grad=True)
+        par_T = torch.tensor(
+            torch.zeros(1).to(self.device), requires_grad=True)
+        optimizer = Adam([par_x, par_o, par_cls, par_T], lr=lr)
+
+        # Empty peptide tensors — receptor-only context
+        empty_pep_coord = rec_data['rec_coord'][:0]
+        empty_pep_aa = rec_data['rec_aa'][:0]
+
+        for t in range(n_steps):
+            new_coord = coord_from(par_x, par_o)
+            data_query = {
+                'rec_coord': rec_data['rec_coord'],
+                'rec_aa': rec_data['rec_aa'],
+                'pep_coord': empty_pep_coord,
+                'pep_aa': empty_pep_aa,
+                'qry_coord': torch.cat([new_coord.unsqueeze(0)]),
+                'qry_aa': torch.tensor([0]),
+            }
+            logits = self.density_model(
+                recursive_to(data_to_batch(data_query, collate_type='default'),
+                             self.device))
+            logits = logits[0, 0]
+            prob = F.softmax(logits, -1)
+            assert prob.shape == (21,)
+
+            obj_cls = -torch.log(
+                (prob[:20] * F.softmax(par_cls / par_T.exp())).sum(-1))
+            obj = obj_cls
+            if t % max(n_steps // 5, 1) == 0 and verbose:
+                print(f'[denovo] {t}/{n_steps}, obj: {obj.item():.3f}, '
+                      f'x: {par_x.detach().cpu().numpy()}, '
+                      f'cls:{par_cls.argmax(-1).item()}')
+
+            optimizer.zero_grad()
+            obj.backward()
+            optimizer.step()
+
+            par_x.data.add_(noise_eps * torch.randn_like(par_x))
+            par_o.data.add_(noise_eps * torch.randn_like(par_o))
+            par_o.data.div_(
+                torch.sqrt((par_o ** 2).sum(dim=-1).unsqueeze(-1)))
+
+        coord = coord_from(par_x, par_o).detach()
+        aa = par_cls.argmax(-1).detach()
+        return coord, aa
+
+    def _get_next(self, data, frag_list, dist_list,
+                  extend_strategy='random', verbose=False):
+        pep_coord = torch.cat([coords for coords, aa in frag_list], dim=0)
+        pep_aa = torch.cat([aa for coords, aa in frag_list], dim=0)
+        pep_length = pep_aa.shape[0]
+        assert pep_coord.shape == (pep_length, 3, 3)
+
+        with torch.no_grad():
+            data_query = {
+                'rec_coord': data['rec_coord'],
+                'rec_aa': data['rec_aa'],
+                'pep_coord': pep_coord,
+                'pep_aa': pep_aa,
+                'qry_coord': pep_coord,
+                'qry_aa': pep_aa,
+            }
+            angle_new, log_kai = self.prediction_model(
+                recursive_to(data_to_batch(data_query, collate_type='default'),
+                             self.device))
+            angle_new = angle_new[0]
+            log_kai = log_kai[0]
+
+        it = sum([coords.shape[0] for coords, aa in frag_list])
+        while True:
+            frag_index = it // 2 % len(frag_list)
+            dir_index = it % 2
+            if dist_list[frag_index + dir_index] > 0:
+                break
+            it += 1
+        assert dist_list[frag_index + dir_index] > 0
+
+        pos_index = (sum([coords.shape[0]
+                          for coords, aa in frag_list[:frag_index]])
+                     + (0 if dir_index == 0
+                        else frag_list[frag_index][0].shape[0] - 1))
+        generate_coord_fn = (generate_prev_coord if dir_index == 0
+                             else generate_next_coord)
+
+        selected_angle = angle_new[pos_index, dir_index]
+        mu_psi, mu_phi = selected_angle[0], selected_angle[1]
+        log_kai_psi, log_kai_phi = log_kai[pos_index, dir_index]
+
+        if extend_strategy == 'sto':
+            psi = VonMises(mu_psi, log_kai_psi.exp()).sample()
+            phi = VonMises(mu_phi, log_kai_phi.exp()).sample()
+            if verbose:
+                print('psi', mu_psi.item(), log_kai_psi.exp().item(),
+                      psi.item(),
+                      'phi', mu_phi.item(), log_kai_phi.exp().item(),
+                      phi.item())
+        elif extend_strategy == 'det':
+            psi = mu_psi
+            phi = mu_phi
+        else:
+            raise NotImplementedError
+
+        sample_angle_eu = torch.stack(
+            [psi.cos(), psi.sin(), phi.cos(), phi.sin()]).reshape(2, 2)
+        coord_new = generate_coord_fn(
+            pep_coord[pos_index], sample_angle_eu.reshape(-1))
+
+        with torch.no_grad():
+            data_query = {
+                'rec_coord': data['rec_coord'],
+                'rec_aa': data['rec_aa'],
+                'pep_coord': pep_coord,
+                'pep_aa': pep_aa,
+                'qry_coord': torch.cat([coord_new.unsqueeze(0)]),
+                'qry_aa': torch.tensor([0]),
+            }
+            logits = self.density_model(
+                recursive_to(data_to_batch(data_query, collate_type='default'),
+                             self.device))
+            logits = logits[0, 0]
+            aa_new = logits[:20].argmax()
+
+        if dir_index == 0:
+            frag_list[frag_index][0] = torch.cat(
+                [coord_new.unsqueeze(0), frag_list[frag_index][0]], dim=0)
+            frag_list[frag_index][1] = torch.cat(
+                [aa_new.unsqueeze(0), frag_list[frag_index][1]], dim=0)
+        else:
+            frag_list[frag_index][0] = torch.cat(
+                [frag_list[frag_index][0], coord_new.unsqueeze(0)], dim=0)
+            frag_list[frag_index][1] = torch.cat(
+                [frag_list[frag_index][1], aa_new.unsqueeze(0)], dim=0)
+
+        dist_list[frag_index + dir_index] -= 1
+        return frag_list, dist_list
+
+    def _get_data_query_denovo(self, rec_data, pep_coord, pep_cls, type):
+        """Build query dict without depending on GT peptide length."""
+        L = pep_coord.shape[0]
+        pep_aa = pep_cls.argmax(-1)
+        return {
+            'rec_coord': rec_data['rec_coord'],
+            'rec_aa': rec_data['rec_aa'],
+            'pep_coord': pep_coord.detach(),
+            'pep_aa': pep_aa.detach(),
+            'qry_coord': pep_coord,
+            'qry_aa': (pep_aa if type == 'angle'
+                       else torch.zeros(L).long().to(pep_coord.device)),
+        }
+
+    def _finetune_denovo(self, rec_data, pep_coord, pep_aa, n_steps=100,
+                         lr=1e-1, finetune_strategy='full', verbose=False):
+        """Finetune using receptor-only context."""
+        assert finetune_strategy in ['full', 'ablation']
+        pep_length = pep_aa.shape[0]
+
+        psi_init = dihedral_from_four_points(
+            pep_coord[:-1, 2], pep_coord[:-1, 0],
+            pep_coord[:-1, 1], pep_coord[1:, 2])
+        phi_init = dihedral_from_four_points(
+            pep_coord[:-1, 1], pep_coord[1:, 2],
+            pep_coord[1:, 0], pep_coord[1:, 1])
+
+        x_init = pep_coord[:, 0]
+        o_init = rotation_matrix_to_quaternion(
+            construct_3d_basis(pep_coord[:, 0], pep_coord[:, 1],
+                               pep_coord[:, 2]))
+
+        par_x = torch.tensor(x_init, requires_grad=True)
+        par_o = torch.tensor(o_init, requires_grad=True)
+        par_psi = torch.tensor(psi_init, requires_grad=True)
+        par_phi = torch.tensor(phi_init, requires_grad=True)
+        par_cls = torch.tensor(
+            torch.zeros(pep_aa.shape[0], 20).float().to(self.device),
+            requires_grad=True)
+        par_T = torch.tensor(
+            0.0 * torch.ones(1).to(self.device), requires_grad=True)
+
+        optimizer = Adam([par_x, par_o, par_psi, par_phi, par_cls, par_T],
+                         lr=lr)
+
+        for t in range(n_steps):
+            this_coord = coord_from(par_x, par_o)
+
+            # structure next
+            data_angle = self._get_data_query_denovo(
+                rec_data, this_coord, par_cls, type='angle')
+            pred_angles, log_kai = self.prediction_model(
+                recursive_to(data_to_batch(data_angle, collate_type='default'),
+                             self.device), 'prefix0')
+            pred_angles = pred_angles[0, :]
+            log_kai = log_kai.squeeze(0)
+            assert pred_angles.shape == (pep_length, 2, 2)
+            assert log_kai.shape == (pep_length, 2, 2)
+            diheral_eu = torch.stack(
+                [par_psi.cos(), par_psi.sin(),
+                 par_phi.cos(), par_phi.sin()], dim=-1)
+            next_coord = generate_next_coord(this_coord[:-1], diheral_eu)
+            obj_str_next = ((next_coord - this_coord[1:]) ** 2).sum(-1).mean()
+            obj_ang_next = (
+                - VonMises(pred_angles[:-1, 1, 0],
+                           log_kai[:-1, 1, 0].exp()).log_prob(par_psi).mean()
+                - VonMises(pred_angles[:-1, 1, 1],
+                           log_kai[:-1, 1, 1].exp()).log_prob(par_phi).mean()
+            )
+
+            # structure prev
+            pred_angles, log_kai = self.prediction_model(
+                recursive_to(data_to_batch(data_angle, collate_type='default'),
+                             self.device), 'suffix0')
+            pred_angles = pred_angles[0, :]
+            log_kai = log_kai.squeeze(0)
+            assert pred_angles.shape == (pep_length, 2, 2)
+            assert log_kai.shape == (pep_length, 2, 2)
+            diheral_eu = torch.stack(
+                [par_psi.cos(), par_psi.sin(),
+                 par_phi.cos(), par_phi.sin()], dim=-1)
+            prev_coord = generate_prev_coord(this_coord[1:], diheral_eu)
+            obj_str_prev = (
+                (prev_coord - this_coord[:-1]) ** 2).sum(-1).mean()
+            obj_ang_prev = (
+                - VonMises(pred_angles[1:, 0, 0],
+                           log_kai[1:, 0, 0].exp()).log_prob(par_psi).mean()
+                - VonMises(pred_angles[1:, 0, 1],
+                           log_kai[1:, 0, 1].exp()).log_prob(par_phi).mean()
+            )
+
+            # class next
+            data_class = self._get_data_query_denovo(
+                rec_data, this_coord, par_cls, type='class')
+            logits = self.density_model(
+                recursive_to(data_to_batch(data_class, collate_type='default'),
+                             self.device), 'prefix0')
+            logits = logits.squeeze(0)
+            assert logits.shape == (pep_length, 21)
+            prob = F.softmax(logits, -1)
+            if finetune_strategy == "ablation":
+                prob = prob.detach()
+            obj_cls_next = -torch.log(
+                (prob[:, :20] * F.softmax(par_cls / par_T.exp())).sum(
+                    -1)).mean()
+
+            # class prev
+            logits = self.density_model(
+                recursive_to(data_to_batch(data_class, collate_type='default'),
+                             self.device), 'suffix0')
+            logits = logits.squeeze(0)
+            assert logits.shape == (pep_length, 21)
+            prob = F.softmax(logits, -1)
+            if finetune_strategy == "ablation":
+                prob = prob.detach()
+            obj_cls_prev = -torch.log(
+                (prob[:, :20] * F.softmax(par_cls / par_T.exp())).sum(
+                    -1)).mean()
+
+            obj = (obj_str_next + obj_str_prev + obj_cls_next + obj_cls_prev
+                   + obj_ang_next + obj_ang_prev)
+
+            if t % max(n_steps // 10, 1) == 0 and verbose:
+                print(f'{t}/{n_steps}',
+                      obj_str_next.item(), obj_str_prev.item(),
+                      obj_ang_next.item(), obj_ang_prev.item(),
+                      obj_cls_next.item(), obj_cls_prev.item(),
+                      par_T.exp().item())
+
+            optimizer.zero_grad()
+            obj.backward()
+            optimizer.step()
+
+            par_o.data.div_(
+                torch.sqrt((par_o ** 2).sum(dim=-1).unsqueeze(-1)))
+
+        pep_coord = coord_from(par_x, par_o).detach()
+        pep_aa = par_cls.argmax(-1).detach()
+        return pep_coord, pep_aa
+
+    def _get_anchor_index(self, L, anchor_nums):
+        base_dist = L // (anchor_nums + 1)
+        anchor_index = [base_dist * (i + 1) for i in range(anchor_nums)]
+        return anchor_index
+
+    def _get_dist_list(self, L, dist_strategy):
+        if dist_strategy == 'multi':
+            if L <= 8:
+                L1 = L // 2
+                L2 = L - L1 - 1
+                return [L1, L2]
+            elif L <= 16:
+                L1, L3 = L // 4, L // 4
+                L2 = L - L1 - L3 - 2
+                return [L1, L2, L3]
+            elif L <= 24:
+                L1, L4 = L // 6, L // 6
+                L2 = (L - L1 - L4 - 2) // 2
+                L3 = L - L1 - L2 - L4 - 3
+                return [L1, L2, L3, L4]
+            elif L < 32:
+                L1, L5 = L // 8, L // 8
+                L2, L4 = ((L - L1 - L5 - 2) // 3,
+                           (L - L1 - L5 - 2) // 3)
+                L3 = L - L1 - L2 - L4 - L5 - 4
+                return [L1, L2, L3, L4, L5]
+            else:
+                raise NotImplementedError
+        elif dist_strategy == 'single':
+            L1 = L // 2
+            L2 = L - L1 - 1
+            return [L1, L2]
+        raise NotImplementedError
+
+    def reverse_engineer_dist_list(self, anchor_index, total_length):
+        dist_list = []
+        previous_index = 0
+        for i in range(len(anchor_index)):
+            current_index = anchor_index[i]
+            dist_list.append(current_index - previous_index)
+            previous_index = current_index + 1
+        dist_list.append(total_length - previous_index)
+        return dist_list
+
+    def _frag_to_seq(self, frag_list):
+        pep_coord = torch.cat([coords for coords, aa in frag_list], dim=0)
+        pep_aa = torch.cat([aa for coords, aa in frag_list], dim=0)
+        return pep_coord, pep_aa
+
+    def _metrics(self, gen, gt):
+        gen_pos = gen['pep_coord'][:, 0].cpu()
+        gen_aa = gen['pep_aa'].cpu()
+        gt_pos = gt['pep_coord'][:, 0].cpu()
+        gt_aa = gt['pep_aa'].cpu()
+
+        recovery = (gen_aa == gt_aa).float().mean().item()
+
+        sup = SVDSuperimposer()
+        sup.set(gt_pos.view(-1, 3).clone().detach().numpy(),
+                gen_pos.view(-1, 3).clone().detach().numpy())
+        sup.run()
+        rmsd = float(sup.get_rms())
+
+        valid_flag = ((gen_pos[:-1] - gen_pos[1:]).norm(p=2, dim=-1)
+                      < 4.5).all().float().item()
+
+        return {'recovery': recovery, 'rmsd': rmsd, 'valid': valid_flag}
+
+    def _validity_metrics(self, gen):
+        """Compute validity metrics without GT reference."""
+        gen_pos = gen['pep_coord'][:, 0]
+        ca_dists = (gen_pos[:-1] - gen_pos[1:]).norm(p=2, dim=-1)
+        valid_flag = (ca_dists < 4.5).all().float().item()
+        return {
+            'valid': valid_flag,
+            'mean_ca_dist': ca_dists.mean().item(),
+        }
+
+    # ------------------------------------------------------------------
+    # Original sample (GT-seeded) — kept for backward compatibility
+    # ------------------------------------------------------------------
+
+    def sample(self, data, anchor_steps=100, finetune_steps=100,
+               dist_strategy='multi', anchor_strategy='ebm',
+               extend_strategy='sto', finetune_strategy='full',
+               verbose=False, anchor_nums=1):
+        assert (data['pep_aa'] != 20).all()
+        pep_length = data['pep_aa'].shape[0]
+        assert 2 <= pep_length <= 32
+        original_data = data
+        data = recursive_to(data, self.device)
+
+        anchor_index = self._get_anchor_index(pep_length, anchor_nums)
+        dist_list = self.reverse_engineer_dist_list(anchor_index, pep_length)
+
+        # Original: anchors from GT peptide
+        frag_list = []
+        for anchor in [sum(dist_list[:i + 1]) + i
+                       for i in range(len(dist_list) - 1)]:
+            coord, aa = data['pep_coord'][anchor], data['pep_aa'][anchor]
+            if anchor_strategy == 'gt':
+                pass
+            elif anchor_strategy == 'ebm':
+                coord, aa = self._rand_anchors(coord, aa)
+                if anchor_steps > 0:
+                    coord, aa = self._sample_anchor(
+                        data, coord, aa, n_steps=anchor_steps, verbose=verbose)
+            elif anchor_strategy == 'rand':
+                coord, aa = self._rand_anchors(coord, aa, x_sig=2.0,
+                                               o_sig=0.5)
+            else:
+                raise NotImplementedError
+            frag_list.append([coord.unsqueeze(0), aa.unsqueeze(0)])
+
+        assert len(dist_list) == len(frag_list) + 1
+        while sum(dist_list) > 0:
+            frag_list, dist_list = self._get_next(
+                data, frag_list, dist_list,
+                extend_strategy=extend_strategy, verbose=verbose)
+        pep_coord, pep_aa = self._frag_to_seq(frag_list)
+        if finetune_steps > 0:
+            pep_coord, pep_aa = self._finetune_denovo(
+                data, pep_coord, pep_aa, n_steps=finetune_steps,
+                finetune_strategy=finetune_strategy, verbose=verbose)
+
+        gen = {'pep_coord': pep_coord.cpu(), 'pep_aa': pep_aa.cpu()}
+        return gen, self._metrics(gen, original_data)
+
+    def _rand_anchors(self, coord, aa, x_sig=1.0, o_sig=0.2):
+        x_init = coord[0]
+        o_init = rotation_matrix_to_quaternion(
+            construct_3d_basis(coord[0], coord[1], coord[2]))
+        x_init = x_init + x_sig * torch.randn_like(x_init)
+        o_init = o_init + o_sig * torch.randn_like(o_init)
+        o_init = F.normalize(o_init, p=2, dim=-1)
+        coord = coord_from(x_init, o_init)
+        aa = torch.randint(0, 20, (1,)).long()[0].to(aa.device)
+        return coord, aa
+
+    # ------------------------------------------------------------------
+    # De novo sample — no GT peptide required
+    # ------------------------------------------------------------------
+
+    def sample_denovo(self, rec_coord, rec_aa, pep_length,
+                      anchor_steps=100, finetune_steps=100,
+                      dist_strategy='multi', extend_strategy='sto',
+                      finetune_strategy='full', verbose=False,
+                      anchor_nums=1):
+        """Generate a peptide de novo given only receptor information.
+
+        Args:
+            rec_coord: (R, 3, 3) receptor backbone coordinates.
+            rec_aa: (R,) receptor amino acid types.
+            pep_length: desired peptide length.
+            anchor_steps: EBM optimisation steps per anchor.
+            finetune_steps: joint fine-tuning steps.
+            dist_strategy: fragment distribution strategy.
+            extend_strategy: 'sto' or 'det'.
+            finetune_strategy: 'full' or 'ablation'.
+            verbose: print progress.
+            anchor_nums: number of anchor fragments.
+
+        Returns:
+            gen: dict with 'pep_coord' (L, 3, 3) and 'pep_aa' (L,).
+            metrics: dict with validity metrics (no GT comparison).
+        """
+        assert 2 <= pep_length <= 32
+
+        rec_data = recursive_to({
+            'rec_coord': rec_coord,
+            'rec_aa': rec_aa,
+        }, self.device)
+
+        # 1. Determine fragment layout
+        anchor_index = self._get_anchor_index(pep_length, anchor_nums)
+        dist_list = self.reverse_engineer_dist_list(anchor_index, pep_length)
+
+        # 2. Initialize anchors from receptor surface + EBM optimisation
+        surface_points = self._sample_surface_points(
+            rec_data['rec_coord'], n_points=len(anchor_index))
+
+        frag_list = []
+        for i, (coord_init, aa_init) in enumerate(surface_points):
+            coord, aa = self._sample_anchor_denovo(
+                rec_data, coord_init, aa_init,
+                n_steps=anchor_steps, verbose=verbose)
+            frag_list.append([coord.unsqueeze(0), aa.unsqueeze(0)])
+
+        # 3. Extend fragments
+        # Build a minimal data dict for _get_next (needs rec_coord, rec_aa)
+        data_for_extend = {
+            'rec_coord': rec_data['rec_coord'],
+            'rec_aa': rec_data['rec_aa'],
+        }
+
+        assert len(dist_list) == len(frag_list) + 1
+        while sum(dist_list) > 0:
+            frag_list, dist_list = self._get_next(
+                data_for_extend, frag_list, dist_list,
+                extend_strategy=extend_strategy, verbose=verbose)
+
+        pep_coord, pep_aa = self._frag_to_seq(frag_list)
+
+        # 4. Fine-tune
+        if finetune_steps > 0:
+            pep_coord, pep_aa = self._finetune_denovo(
+                rec_data, pep_coord, pep_aa, n_steps=finetune_steps,
+                finetune_strategy=finetune_strategy, verbose=verbose)
+
+        gen = {'pep_coord': pep_coord.cpu(), 'pep_aa': pep_aa.cpu()}
+        return gen, self._validity_metrics(gen)
